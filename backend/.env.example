# Local development defaults
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:1b
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Opportunity source integrations
# Keep credentials here locally or in your deployment secret manager. Never commit real secrets.

# The Muse API: register for access before use.
THE_MUSE_API_KEY=
THE_MUSE_MAX_PAGES=3

# Adzuna API: register for an app ID/key; verify country coverage and terms.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
ADZUNA_INTERNSHIP_QUERY=internship

# Public company-specific ATS boards, not a universal job search.
# Only configure board tokens/site names for published listings you are authorized to ingest.
GREENHOUSE_BOARD_TOKENS=
LEVER_SITE_NAMES=

# Publisher-provided or otherwise authorized RSS/Atom feed URLs, comma-separated.
OPPORTUNITY_RADAR_RSS_FEEDS=

# Sync controls
OPPORTUNITY_SOURCE_AUTO_SYNC=true
OPPORTUNITY_SOURCE_SYNC_INTERVAL_MINUTES=360
OPPORTUNITY_SOURCE_TIMEOUT_SECONDS=10

# Strong random token recommended for deployed services. Needed for remote sync requests.
OPPORTUNITY_RADAR_SYNC_TOKEN=
