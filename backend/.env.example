# Copy this file to backend/.env. Never commit backend/.env or real credentials.
# The Muse: obtain an app key through the official developer portal.
THEMUSE_API_KEY=

# Adzuna: obtain an app ID and key through the official developer portal.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
ADZUNA_QUERY=internship

# Optional public job-board endpoints for specific employers, comma-separated.
# Greenhouse examples are board tokens, not API keys.
GREENHOUSE_BOARD_TOKENS=
# Lever examples are employer site identifiers, not API keys.
LEVER_SITES=

# Required to enable POST /api/sources/sync. Generate a long random value.
# Example command: python -c "import secrets; print(secrets.token_urlsafe(32))"
SOURCE_SYNC_TOKEN=

# Frontend origins allowed to call this backend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional local Ollama settings used by the existing AI extraction/matching pipeline.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:1b
